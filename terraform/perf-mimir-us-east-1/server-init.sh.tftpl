#!/bin/bash
# Bootstrap of the perf Mimir server (rendered by Terraform; runs once per instance via cloud-init).
# State that matters is on the data EBS volume (/data) and in S3; everything here is idempotent.
# Ubuntu 26.04 LTS; nginx from nginx.org; Mimir as a plain binary under systemd (no containers).
set -euo pipefail
exec > >(tee -a /var/log/server-init.log) 2>&1
echo "server-init: start $(date -u +%FT%TZ)"

REGION="${region}"
BUCKET="${bucket}"
HOST_NAME="${hostname}"
SSM_PREFIX="${ssm_prefix}"
VOLUME_ID="${data_volume}"
MIMIR_VERSION="${mimir_version}"
ARCH=$(dpkg --print-architecture) # amd64 or arm64
case "$ARCH" in
  amd64) MIMIR_SHA256="${mimir_sha256_amd64}"; AWSCLI_ARCH=x86_64 ;;
  arm64) MIMIR_SHA256="${mimir_sha256_arm64}"; AWSCLI_ARCH=aarch64 ;;
  *) echo "server-init: unsupported architecture $ARCH"; exit 1 ;;
esac
MAX_SERIES_TOTAL="${max_series_total}"

# Settings for the helper scripts below (quoted heredocs: they read these at run time).
cat > /etc/default/perf-mimir <<ENV
REGION=$REGION
BUCKET=$BUCKET
HOST_NAME=$HOST_NAME
SSM_PREFIX=$SSM_PREFIX
MAX_SERIES_TOTAL=$MAX_SERIES_TOTAL
ENV

export DEBIAN_FRONTEND=noninteractive
# First boot: unattended-upgrades may hold the dpkg lock; mirrors may blip.
cat > /etc/apt/apt.conf.d/80-server-init <<'APT'
DPkg::Lock::Timeout "600";
Acquire::Retries "5";
APT
apt-get update -y
apt-get install -y --no-install-recommends certbot unzip curl openssl gnupg ca-certificates unattended-upgrades python3-yaml logrotate

# --- nginx from nginx.org (${nginx_channel}) ----------------------------------------------------------
# The signing keys are pinned by fingerprint (https://nginx.org/en/linux_packages.html); apt prefers this
# origin for nginx, and unattended-upgrades applies its updates like Ubuntu's security updates.
curl -fsSL https://nginx.org/keys/nginx_signing.key | gpg --dearmor > /tmp/nginx-keyring.gpg
for fpr in $(gpg --show-keys --with-colons /tmp/nginx-keyring.gpg | awk -F: '/^pub/ {p = 1; next} /^fpr/ && p {print $10; p = 0}'); do
  case "$fpr" in
    573BFD6B3D8FBC641079A6ABABF5BD827BD9BF62 | 8540A6F18833A80E9C1653A42FD21310B49F6B46 | 9E9BE90EACBCDE69FE9B204CBCDCD8A38D88A2B3) ;;
    *) echo "server-init: unexpected nginx.org signing key $fpr"; exit 1 ;;
  esac
done
install -m 0644 /tmp/nginx-keyring.gpg /usr/share/keyrings/nginx-archive-keyring.gpg && rm -f /tmp/nginx-keyring.gpg
CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/%{ if nginx_channel == "mainline" }mainline/%{ endif }ubuntu $CODENAME nginx" > /etc/apt/sources.list.d/nginx.list
printf 'Package: *\nPin: origin nginx.org\nPin: release o=nginx\nPin-Priority: 900\n' > /etc/apt/preferences.d/99nginx
cat > /etc/apt/apt.conf.d/52unattended-upgrades-nginx <<'APT'
Unattended-Upgrade::Origins-Pattern { "origin=nginx,codename=$${distro_codename}"; };
APT
apt-get update -y
apt-get install -y --no-install-recommends nginx
nginx -v

# AWS CLI v2 (SSM, the health metrics).
if ! command -v aws >/dev/null; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$AWSCLI_ARCH.zip" -o /tmp/awscli.zip
  unzip -q /tmp/awscli.zip -d /tmp && /tmp/aws/install --update && rm -rf /tmp/aws /tmp/awscli.zip
fi

# --- The data volume --------------------------------------------------------------------------------
# Found by its volume ID (Nitro device names aren't stable), formatted only if it has no filesystem, and
# checked against a sentinel so Mimir never starts on a foreign disk by mistake. The sentinel names the
# role, not the volume, so a volume restored from a snapshot (new ID) is accepted. A blank volume is fine:
# every shipped block is in S3, so a new volume only lacks the samples that were never shipped.
SENTINEL="perf-mimir-data"
DEV="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$(echo "$VOLUME_ID" | tr -d '-')"
for _ in $(seq 1 120); do [ -e "$DEV" ] && break; sleep 5; done
[ -e "$DEV" ] || { echo "server-init: data volume $VOLUME_ID never attached"; exit 1; }
FRESH=0
# -p probes the device itself (no cache); exit 2 = no filesystem, anything else nonzero is an error.
blk=0; blkid -p "$DEV" >/dev/null 2>&1 || blk=$?
[ "$blk" = 0 ] || [ "$blk" = 2 ] || { echo "server-init: blkid failed ($blk) on $DEV"; exit 1; }
if [ "$blk" = 2 ]; then
  # A second guard: a new EBS volume reads as zeros; anything else isn't formatted on blkid's word alone.
  cmp -s -n 1048576 "$DEV" /dev/zero || { echo "server-init: $DEV has no filesystem but isn't blank; not formatting it"; exit 1; }
  echo "server-init: new data volume, formatting"
  mkfs.ext4 -q -L mimirdata "$DEV"
  FRESH=1
fi
mkdir -p /data
# By UUID: a second volume with the same label (e.g. a snapshot attached for inspection) can't be mounted.
UUID=$(blkid -p -s UUID -o value "$DEV")
sed -i '\| /data |d' /etc/fstab
echo "UUID=$UUID /data ext4 defaults,nofail,noatime 0 2" >> /etc/fstab
systemctl daemon-reload
mountpoint -q /data || mount /data
resize2fs "$(readlink -f "$DEV")" || true # a grown volume
# A volume formatted by an earlier run that failed before writing the sentinel: ours, and still empty.
if [ "$FRESH" = 0 ] && [ ! -e /data/.perf-mimir ] && [ "$(blkid -p -s LABEL -o value "$DEV")" = mimirdata ] &&
  [ "$(ls -A /data)" = lost+found ]; then FRESH=1; fi
if [ "$FRESH" = 1 ]; then
  echo "$SENTINEL" > /data/.perf-mimir
elif [ "$(cat /data/.perf-mimir 2>/dev/null)" != "$SENTINEL" ]; then
  echo "server-init: /data is not a perf Mimir data volume (sentinel mismatch); not starting Mimir"
  exit 1
fi

# A fixed UID, so the files on the data volume keep their owner across instance replacements.
getent group mimir >/dev/null || groupadd --system --gid 10010 mimir
getent passwd mimir >/dev/null || useradd --system --uid 10010 --gid mimir --home-dir /data/mimir --no-create-home --shell /usr/sbin/nologin mimir
mkdir -p /data/mimir/tsdb /data/mimir/tsdb-sync /data/mimir/compactor /data/mimir/ruler /data/letsencrypt /etc/mimir /var/log/mimir
chown -R mimir:mimir /data/mimir
chmod 0750 /data/mimir
# Certificates live on the volume, so a replaced instance keeps them (Let's Encrypt rate limits).
if [ ! -L /etc/letsencrypt ]; then rm -rf /etc/letsencrypt; ln -s /data/letsencrypt /etc/letsencrypt; fi

# --- Mimir ------------------------------------------------------------------------------------------
# The release binary, checked against the pinned SHA-256 before it's installed; a mismatch stops here.
BIN=/usr/local/lib/mimir/mimir-$MIMIR_VERSION
mkdir -p /usr/local/lib/mimir
if ! echo "$MIMIR_SHA256  $BIN" | sha256sum -c --status 2>/dev/null; then
  curl -fsSL --connect-timeout 10 --max-time 900 --retry 8 --retry-delay 15 --retry-all-errors -o "$BIN.download" \
    "https://github.com/grafana/mimir/releases/download/mimir-$MIMIR_VERSION/mimir-linux-$ARCH" ||
    { echo "server-init: mimir $MIMIR_VERSION download failed (re-run the bootstrap: README, planned replacement)"; exit 1; }
  echo "$MIMIR_SHA256  $BIN.download" | sha256sum -c - || { echo "server-init: mimir $MIMIR_VERSION checksum mismatch"; rm -f "$BIN.download"; exit 1; }
  install -m 0755 "$BIN.download" "$BIN" && rm -f "$BIN.download"
fi
ln -sfn "$BIN" /usr/local/bin/mimir
/usr/local/bin/mimir -version

# Monolithic (-target=all), one replica. Every port is on 127.0.0.1: nginx is the only way in from outside,
# and an SSM port forward to 9009 is the way in for people. The components register in the internal rings at
# 127.0.0.1: gRPC only listens there, and the default (the host's private IP) would make them unreachable.
cat > /etc/mimir/config.yaml <<CFG
target: all
multitenancy_enabled: true
usage_stats:
  enabled: false
server:
  http_listen_address: 127.0.0.1
  http_listen_port: 9009
  grpc_listen_address: 127.0.0.1
  grpc_listen_port: 9095
  log_level: info
memberlist:
  bind_addr: [127.0.0.1]
  advertise_addr: 127.0.0.1
common:
  storage:
    backend: s3
    s3:
      endpoint: s3.$REGION.amazonaws.com
      region: $REGION
      bucket_name: $BUCKET
blocks_storage:
  storage_prefix: blocks
  tsdb:
    dir: /data/mimir/tsdb
    wal_compression_enabled: true
  bucket_store:
    sync_dir: /data/mimir/tsdb-sync
    # A long-range query opens one index header per day per tenant: load them 16 at a time, not 4.
    index_header:
      lazy_loading_concurrency: 16
# The ruler is part of -target=all; its API isn't served (nginx), so this stays empty.
ruler_storage:
  storage_prefix: ruler
compactor:
  data_dir: /data/mimir/compactor
  sharding_ring:
    instance_addr: 127.0.0.1
ruler:
  rule_path: /data/mimir/ruler
  ring:
    instance_addr: 127.0.0.1
distributor:
  ring:
    instance_addr: 127.0.0.1
ingester:
  ring:
    replication_factor: 1
    instance_addr: 127.0.0.1
    tokens_file_path: /data/mimir/tsdb/tokens
  instance_limits:
    max_series: ${max_series_total}
    max_ingestion_rate: ${max_ingestion_rate_total}
store_gateway:
  sharding_ring:
    replication_factor: 1
    instance_addr: 127.0.0.1
query_scheduler:
  # A query is split into many sub-queries (by day, then sharded): room for a dashboard full of them.
  max_outstanding_requests_per_tenant: 800
  ring:
    instance_addr: 127.0.0.1
querier:
  # Queries share the process (and its memory) with ingestion: fewer at a time, each bounded (limits below).
  max_concurrent: 4
  ring:
    instance_addr: 127.0.0.1
frontend:
  address: 127.0.0.1
runtime_config:
  file: /etc/mimir/runtime.yaml
# Defaults for every tenant; the runtime config (Terraform's tenant_limits) overrides them per tenant.
limits:
  compactor_blocks_retention_period: ${retention_period}
  max_global_series_per_user: ${max_series_per_tenant}
  ingestion_rate: ${ingestion_rate}
  ingestion_burst_size: ${ingestion_burst_size}
  max_label_names_per_series: ${max_label_names_per_series}
  max_label_name_length: ${max_label_name_length}
  max_label_value_length: ${max_label_value_length}
  out_of_order_time_window: ${out_of_order_time_window}
  # Query guards, so one wide query can't take the process (and ingestion) down; overridable per tenant.
  max_estimated_memory_consumption_per_query: 2147483648
  max_fetched_chunk_bytes_per_query: 2147483648
  max_fetched_series_per_query: 1000000
  # Blocks aren't split by the compactor, so every shard reads every block's index: 4, not 16, on 4 vCPU.
  query_sharding_total_shards: 4
CFG
chown root:mimir /etc/mimir/config.yaml && chmod 0640 /etc/mimir/config.yaml
[ -s /etc/mimir/runtime.yaml ] || echo "overrides: {}" > /etc/mimir/runtime.yaml
chown root:mimir /etc/mimir/runtime.yaml && chmod 0640 /etc/mimir/runtime.yaml

# Go's soft memory limit at 80 % of the instance's memory (read at every start, so an instance type change
# needs no bootstrap), and the hard cgroup limit at 92 %.
cat > /usr/local/sbin/mimir-start <<'SCRIPT'
#!/bin/sh
kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
GOMEMLIMIT=$(( kib * 1024 / 100 * 80 ))
export GOMEMLIMIT
exec /usr/local/bin/mimir -config.file=/etc/mimir/config.yaml
SCRIPT
chmod 0755 /usr/local/sbin/mimir-start

cat > /usr/local/sbin/mimir-prestart <<'SCRIPT'
#!/bin/sh
f=/etc/mimir/runtime.yaml
if ! why=$(python3 /usr/local/lib/mimir/check-overrides.py /etc/mimir/config.yaml /usr/local/bin/mimir < "$f" 2>&1); then
  echo "mimir-prestart: $f refused ($why); starting with no overrides"
  echo "overrides: {}" > "$f" && chown root:mimir "$f" && chmod 0640 "$f"
fi
exit 0
SCRIPT
chmod 0755 /usr/local/sbin/mimir-prestart

cat > /etc/systemd/system/mimir.service <<'UNIT'
[Unit]
Description=Grafana Mimir (monolithic, blocks on S3)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data
ConditionPathExists=/data/.perf-mimir
# touch /data/.hold to keep Mimir stopped (maintenance); the watchdog only reports.
ConditionPathExists=!/data/.hold
StartLimitIntervalSec=0

[Service]
User=mimir
Group=mimir
WorkingDirectory=/data/mimir
# Never start on a runtime config the check refuses (a binary or config change can make an old one invalid):
# fall back to no overrides, which mimir-limits then flags (the config-rejected alarm) and retries.
ExecStartPre=+/usr/local/sbin/mimir-prestart
ExecStart=/usr/local/sbin/mimir-start
Restart=always
RestartSec=10
# The ingester closes its TSDB on SIGTERM (the WAL is already on disk); a restart replays the WAL.
TimeoutStopSec=120
LimitNOFILE=1048576
MemoryMax=92%
StandardOutput=append:/var/log/mimir/mimir.log
StandardError=inherit
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/data/mimir
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/logrotate.d/perf-mimir <<'ROT'
/var/log/mimir/mimir.log /var/log/perf-mimir-ops.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
ROT

# Scratch and status files of the helper scripts (root only; the watchdog publishes the status files).
cat > /etc/tmpfiles.d/perf-mimir.conf <<'TMP'
d /run/perf-mimir 0700 root root -
TMP
systemd-tmpfiles --create /etc/tmpfiles.d/perf-mimir.conf

# --- Per-tenant limits: SSM -> Mimir's runtime config --------------------------------------------------
cat > /usr/local/lib/mimir/check-overrides.py <<'PY'
# check-overrides.py CONFIG MIMIR < runtime.yaml: exits nonzero unless stdin is
# {"overrides": {tenant: {limit: value}}} with well-formed tenant names and limits this Mimir takes as given.
# Each tenant's limits go into a copy of the server's config, which the binary parses, validates and prints
# back (-print.config): a wrong name, type or value (or one Mimir would silently round) is refused here, not
# by a running Mimir, or by one that then can't start.
import copy
import re
import subprocess
import sys
import tempfile

import yaml

UNITS = {"ms": 0.001, "s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800, "y": 31536000}


def seconds(v):
    if v == 0 or v == "0":
        return 0.0
    if isinstance(v, str) and re.fullmatch(r"([0-9]+(ms|s|m|h|d|w|y))+", v):
        return sum(int(n) * UNITS[u] for n, u in re.findall(r"([0-9]+)(ms|s|m|h|d|w|y)", v))
    return None


def same(want, got):
    if isinstance(want, bool) or isinstance(got, bool):
        return want is got
    if isinstance(want, (int, float)) and isinstance(got, (int, float)):
        return float(want) == float(got)
    if seconds(want) is not None and seconds(got) is not None:
        return seconds(want) == seconds(got)
    return want == got


config, binary = sys.argv[1], sys.argv[2]
base = yaml.safe_load(open(config))
base.pop("runtime_config", None)
try:
    doc = yaml.safe_load(sys.stdin)
except yaml.YAMLError as e:
    sys.exit("not YAML: %s" % e)
if not isinstance(doc, dict) or set(doc) != {"overrides"}:
    sys.exit("the top level must be exactly 'overrides'")
overrides = doc["overrides"] or {}
if not isinstance(overrides, dict):
    sys.exit("'overrides' must be a map")
for tenant, limits in overrides.items():
    if not isinstance(tenant, str) or not re.fullmatch(r"[a-z][a-z0-9_]{0,31}", tenant):
        sys.exit("bad tenant name: %r" % (tenant,))
    if limits is None or limits == {}:
        continue
    if not isinstance(limits, dict):
        sys.exit("%s: limits must be a map" % tenant)
    cfg = copy.deepcopy(base)
    cfg.setdefault("limits", {}).update(limits)
    with tempfile.NamedTemporaryFile("w", suffix=".yaml") as f:
        yaml.safe_dump(cfg, f)
        f.flush()
        r = subprocess.run([binary, "-config.file=" + f.name, "-print.config"], capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        sys.exit("%s: Mimir refuses these limits: %s" % (tenant, (r.stderr.strip().splitlines() or ["?"])[-1][:300]))
    printed = (yaml.safe_load(r.stdout) or {}).get("limits", {})
    for name, value in limits.items():
        if name not in printed:
            sys.exit("%s: unknown limit %s" % (tenant, name))
        if not same(value, printed[name]):
            sys.exit("%s: %s: %r would become %r" % (tenant, name, value, printed[name]))
PY
cat > /usr/local/sbin/mimir-limits <<'SCRIPT'
#!/bin/bash
# The per-tenant overrides come from an SSM parameter Terraform writes (`tenants`). A missing parameter means
# no overrides; an SSM error or a value the check rejects keeps the current file. Mimir re-reads the file
# every 10 s. The check runs the new value through the Mimir binary first; if the running Mimir still refuses
# it (it then keeps the last good one), the previous file is put back, so a restart doesn't fail on it, and
# that value isn't tried again. /run/perf-mimir/limits.rejected
# is 1 while the parameter's value isn't in force (the watchdog alarms on it).
set -u
. /etc/default/perf-mimir
f=/etc/mimir/runtime.yaml
st=/run/perf-mimir
install -d -m 0700 "$st"
refused=/data/.mimir-limits.refused # on the data volume: a replacement doesn't retry a refused value
log() { echo "$(date -u +%FT%TZ) mimir-limits: $*"; }
if ! new=$(aws ssm get-parameter --region "$REGION" --name "$SSM_PREFIX/runtime-overrides" \
  --query Parameter.Value --output text 2>"$st/limits.err"); then
  if grep -q ParameterNotFound "$st/limits.err"; then new="overrides: {}"; else
    log "SSM error, keeping the current file: $(head -c 300 "$st/limits.err")"
    exit 0
  fi
fi
if [ "$new" = "$(cat "$f" 2>/dev/null)" ]; then echo 0 > "$st/limits.rejected"; exit 0; fi
if [ "$new" = "$(cat "$refused" 2>/dev/null)" ]; then echo 1 > "$st/limits.rejected"; exit 0; fi
if ! why=$(printf '%s\n' "$new" | python3 /usr/local/lib/mimir/check-overrides.py /etc/mimir/config.yaml /usr/local/bin/mimir 2>&1); then
  log "rejected ($why), keeping the current file"
  printf '%s\n' "$new" > "$refused"
  echo 1 > "$st/limits.rejected"
  exit 0
fi
cp -p "$f" "$f.prev"
printf '%s\n' "$new" > "$f.tmp" && chown root:mimir "$f.tmp" && chmod 0640 "$f.tmp" && mv "$f.tmp" "$f"
log "runtime overrides updated"
echo 0 > "$st/limits.rejected"
# /metrics answers while the WAL replays, unlike /ready.
if curl -sf -m 5 -o /dev/null http://127.0.0.1:9009/metrics; then
  sleep 15
  if curl -sf -m 10 http://127.0.0.1:9009/metrics | grep -q '^cortex_runtime_config_last_reload_successful{[^}]*} 0$'; then
    mv "$f.prev" "$f"
    printf '%s\n' "$new" > "$refused"
    echo 1 > "$st/limits.rejected"
    log "Mimir refused the new overrides (mimir.log says why); put the previous ones back"
  fi
fi
exit 0
SCRIPT
chmod 0755 /usr/local/sbin/mimir-limits

# --- nginx: TLS, per-tenant credentials, path allowlist ------------------------------------------------
mkdir -p /etc/systemd/system/nginx.service.d
cat > /etc/systemd/system/nginx.service.d/perf-mimir.conf <<'UNIT'
[Unit]
RequiresMountsFor=/data
[Service]
Restart=on-failure
RestartSec=5
UNIT
mkdir -p /etc/nginx/htpasswd /var/www/acme /etc/nginx/perf
for role in push read; do
  [ -e /etc/nginx/htpasswd/$role ] || install -m 0640 -o root -g nginx /dev/null /etc/nginx/htpasswd/$role
done
cat > /usr/local/sbin/mimir-credentials <<'SCRIPT'
#!/bin/bash
# The htpasswd lines come from SSM SecureString parameters, written out of band: one per role, one line per
# user, users named <tenant>-<role>-<1|2>. nginx sends the tenant part as X-Scope-OrgID, so whoever writes
# the parameter decides which tenant a credential reaches; a client never does. Only the tenants Terraform
# lists ($SSM_PREFIX/tenants) are admitted. Each line is checked on its own: SHA-512 crypt, a well-formed
# name for the role's own file, a listed tenant. Bad lines are dropped and logged (and counted in
# /run/perf-mimir/credentials.rejected, which the watchdog alarms on); the good ones are installed. A missing
# parameter empties the file (every request then fails authentication: closed; deleting the parameter
# revokes the role for every tenant); an SSM error keeps the current file.
set -u
. /etc/default/perf-mimir
st=/run/perf-mimir
install -d -m 0700 "$st"
log() { echo "$(date -u +%FT%TZ) mimir-credentials: $*"; }
# The tenant list, cached so an SSM error keeps the last one.
tenants=/etc/nginx/perf/tenants
if t=$(aws ssm get-parameter --region "$REGION" --name "$SSM_PREFIX/tenants" --query Parameter.Value --output text 2>"$st/credentials.err"); then
  printf '%s\n' "$t" | grep -xE '[a-z][a-z0-9_]{0,31}' > "$tenants.tmp"; mv "$tenants.tmp" "$tenants"
elif grep -q ParameterNotFound "$st/credentials.err"; then
  : > "$tenants"
else
  log "tenants: SSM error, keeping the current list: $(head -c 300 "$st/credentials.err")"
fi
touch "$tenants"
changed=0
rejected=0
for role in push read; do
  f=/etc/nginx/htpasswd/$role
  if ! new=$(aws ssm get-parameter --region "$REGION" --with-decryption --name "$SSM_PREFIX/htpasswd/$role" \
    --query Parameter.Value --output text 2>"$st/credentials.err"); then
    if grep -q ParameterNotFound "$st/credentials.err"; then new=""; else
      log "$role: SSM error, keeping the current file: $(head -c 300 "$st/credentials.err")"
      continue
    fi
  fi
  good=""
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    user=$${line%%:*}
    if ! printf '%s\n' "$line" | grep -qE "^[a-z][a-z0-9_]{0,31}-$role-[12]:\\\$6\\\$[./A-Za-z0-9]{1,16}\\\$[./A-Za-z0-9]{86}\$"; then
      log "$role: dropped a malformed line (user '$${user:0:40}'; only <tenant>-$role-1|2 with a SHA-512 crypt hash)"
      rejected=$(( rejected + 1 )); continue
    fi
    if ! grep -qxF "$${user%-$role-*}" "$tenants"; then
      log "$role: dropped $user: tenant $${user%-$role-*} isn't in $SSM_PREFIX/tenants"
      rejected=$(( rejected + 1 )); continue
    fi
    good="$good$line"$'\n'
  done <<< "$new"
  if [ "$(printf '%s' "$good")" != "$(cat "$f" 2>/dev/null)" ]; then
    printf '%s' "$good" > "$f.tmp" && chown root:nginx "$f.tmp" && chmod 0640 "$f.tmp" && mv "$f.tmp" "$f"
    log "$role: $(grep -c . "$f") user(s), tenants: $(cut -d- -f1 "$f" | sort -u | paste -sd, -)"
    changed=1
  fi
done
echo "$rejected" > "$st/credentials.rejected"
if [ "$changed" = 1 ]; then nginx -t -q && systemctl reload nginx; fi
exit 0
SCRIPT
chmod 0755 /usr/local/sbin/mimir-credentials

rm -f /etc/nginx/conf.d/default.conf /etc/nginx/sites-enabled/default
cat > /etc/nginx/conf.d/00-acme.conf <<NGX
server_tokens off;
server {
    listen 80 default_server;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location = /healthz { access_log off; return 200 "ok\n"; }
    location / { return 301 https://$HOST_NAME\$request_uri; }
}
NGX

READ_ALLOW=""
%{ for cidr in read_allowed_cidrs ~}
READ_ALLOW="$READ_ALLOW        allow ${cidr};"$'\n'
%{ endfor ~}
cat > /etc/nginx/perf/mimir-443.conf <<NGX
# Credential -> tenant: the user name's prefix (<tenant>-push-1 -> <tenant>). Evaluated when the request is
# proxied, i.e. after auth_basic has verified the user. Anything else maps to "" and the header is dropped:
# Mimir then rejects the request (closed). The client's own X-Scope-OrgID is never passed on.
map \$remote_user \$mimir_tenant {
    default "";
    "~^(?<tenant>[a-z][a-z0-9_]{0,31})-(?:push|read)-[12]\$" \$tenant;
}
# Limits key on the client IP: \$remote_user isn't verified before auth_basic runs. Pushes share NAT IPs
# (a whole cell or client host behind one), so their limit is high; Mimir's per-tenant limits do the rest.
limit_req_zone  \$binary_remote_addr zone=push_ip:10m rate=200r/s;
limit_req_zone  \$binary_remote_addr zone=read_ip:10m rate=50r/s;
limit_conn_zone \$binary_remote_addr zone=conn_ip:10m;
limit_req_status 429;
limit_conn_status 429;
# Successful pushes aren't logged (tens a second, all alike); failed ones and every read are.
map \$status \$mimir_log_push { ~^2 0; default 1; }
upstream mimir { server 127.0.0.1:9009; keepalive 32; }

server {
    listen 443 ssl;
    http2 on;
    server_name $HOST_NAME;
    ssl_certificate     /etc/letsencrypt/live/$HOST_NAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$HOST_NAME/privkey.pem;
    # Mozilla "intermediate".
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_body_timeout 15s;
    client_header_timeout 10s;
    limit_conn conn_ip 256;

    proxy_http_version 1.1;
    proxy_set_header Connection    "";
    proxy_set_header Host          \$host;
    proxy_set_header X-Scope-OrgID \$mimir_tenant;
    proxy_set_header Authorization "";

    location = /healthz { access_log off; return 200 "ok\n"; }

    # Push: Prometheus remote_write (Alloy, Prometheus, the OpenTelemetry collector's prometheusremotewrite).
    # Push credentials only.
    location = /api/v1/push {
        limit_except POST { deny all; }
        auth_basic           "mimir-push";
        auth_basic_user_file /etc/nginx/htpasswd/push;
        access_log /var/log/nginx/access.log main if=\$mimir_log_push;
        limit_req zone=push_ip burst=400 nodelay;
        client_max_body_size    16m;
        client_body_buffer_size 1m;
        proxy_pass http://mimir;
    }

    # Read: the Prometheus query API for a Grafana datasource. Read credentials only, and only from the
    # allowed sources.
    location ~ ^/prometheus/api/v1/(query|query_range|series|labels|label/[^/]+/values|metadata)\$ {
        limit_except GET POST { deny all; }
$READ_ALLOW        deny all;
        auth_basic           "mimir-read";
        auth_basic_user_file /etc/nginx/htpasswd/read;
        limit_req  zone=read_ip burst=200 nodelay;
        client_max_body_size 1m;
        proxy_read_timeout 130s;
        proxy_pass http://mimir;
    }

    # Everything else (the UI, admin and ring pages, the ruler and alertmanager APIs, other APIs) is not served.
    location / { return 403; }
}
# Another (or no) name: no handshake; the right name with another Host header: 421.
server { listen 443 ssl default_server; ssl_reject_handshake on; return 421; }
NGX

cat > /usr/local/sbin/mimir-tls <<'SCRIPT'
#!/bin/bash
# Gets the certificate once the A record points here (retried by a timer), then enables the 443 server.
# Renewals: certbot's own timer, with the saved webroot and the deploy hook.
set -u
. /etc/default/perf-mimir
# The certificates live on /data (mounted nofail): without it, certbot would issue onto the root disk.
mountpoint -q /data || { echo "mimir-tls: /data isn't mounted"; exit 0; }
cert=/etc/letsencrypt/live/$HOST_NAME/fullchain.pem
if [ ! -s "$cert" ]; then
  # Only once the name resolves to this server: failed validations are rate limited (5 per hour).
  token=$(curl -s -m 2 -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
  myip=$(curl -s -m 2 -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/public-ipv4)
  getent ahostsv4 "$HOST_NAME" | awk '{print $1}' | grep -qx "$myip" || { echo "mimir-tls: $HOST_NAME doesn't resolve to $myip yet"; exit 0; }
  certbot certonly --webroot -w /var/www/acme -d "$HOST_NAME" %{ if acme_email != "" }--email "${acme_email}"%{ else }--register-unsafely-without-email%{ endif } --agree-tos -n --keep \
    --deploy-hook "systemctl reload nginx" || exit 0
fi
if [ -s "$cert" ] && [ ! -e /etc/nginx/conf.d/10-mimir.conf ]; then
  ln -s /etc/nginx/perf/mimir-443.conf /etc/nginx/conf.d/10-mimir.conf
  if nginx -t; then systemctl reload nginx; else
    echo "mimir-tls: the 443 server fails nginx -t; left disabled"
    rm -f /etc/nginx/conf.d/10-mimir.conf
    exit 1
  fi
fi
SCRIPT
chmod 0755 /usr/local/sbin/mimir-tls

# --- The health watchdog ----------------------------------------------------------------------------
cat > /usr/local/sbin/mimir-watchdog <<'SCRIPT'
#!/bin/bash
# Every minute, in one call, these metrics (namespace PerfMimir, dimension InstanceId):
#   Ready                      1 when Mimir is ready and nginx serves /healthz (on 443 once the
#                              certificate is there, on 80 before);
#   CertDaysLeft               days the certificate has left (0 before it exists);
#   ConfigRejected             credential lines dropped plus 1 if the tenant overrides aren't in force;
# and, while Mimir is ready:
#   DiscardedSamples           the increase of cortex_discarded_samples_total (all reasons and tenants);
#   SeriesUsedPercent          in-memory series across tenants, as a percentage of MAX_SERIES_TOTAL;
#   ShipperFailures            the increase of failed block uploads to S3;
#   CompactorHoursSinceSuccess hours since the compactor last finished a run.
# It only reports: a Mimir that isn't ready may be replaying its WAL, which mustn't be interrupted.
set -u
. /etc/default/perf-mimir
st=/run/perf-mimir
install -d -m 0700 "$st"
token=$(curl -s -m 2 -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
iid=$(curl -s -m 2 -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id)
case "$iid" in i-*) ;; *) echo "mimir-watchdog: no instance id from IMDS"; exit 1 ;; esac
data=""
add() { data="$data$${data:+,}{\"MetricName\":\"$1\",\"Value\":$2,\"Dimensions\":[{\"Name\":\"InstanceId\",\"Value\":\"$iid\"}]}"; }
# The increase of a counter since the last run (0 the first time, the whole value after a restart).
increase() {
  local prev; prev=$(cat "$st/$1" 2>/dev/null || echo "$2")
  echo "$2" > "$st/$1"
  awk -v c="$2" -v p="$prev" 'BEGIN {d = c - p; if (d < 0) d = c; printf "%.0f", d}'
}

ready=0; curl -sf -m 5 http://127.0.0.1:9009/ready >/dev/null && ready=1
cert=/etc/letsencrypt/live/$HOST_NAME/fullchain.pem
days=0
if openssl x509 -enddate -noout -in "$cert" >/dev/null 2>&1; then
  for d in $(seq 0 90); do openssl x509 -checkend $(( (d + 1) * 86400 )) -noout -in "$cert" >/dev/null || break; days=$(( d + 1 )); done
  edge=0; curl -sf -m 5 --resolve "$HOST_NAME:443:127.0.0.1" "https://$HOST_NAME/healthz" >/dev/null && edge=1
else
  edge=0; curl -sf -m 5 http://127.0.0.1/healthz >/dev/null && edge=1
fi
add Ready $(( ready && edge ))
add CertDaysLeft "$days"
add ConfigRejected $(( $(cat "$st/credentials.rejected" 2>/dev/null || echo 0) + $(cat "$st/limits.rejected" 2>/dev/null || echo 0) ))

if [ "$ready" = 1 ] && metrics=$(curl -sf -m 10 http://127.0.0.1:9009/metrics); then
  sum() { printf '%s\n' "$metrics" | awk -v m="$1" '$1 == m || index($1, m "{") == 1 {s += $NF} END {printf "%.0f", s}'; }
  add DiscardedSamples "$(increase discarded "$(sum cortex_discarded_samples_total)")"
  add ShipperFailures "$(increase shipper "$(sum cortex_ingester_shipper_upload_failures_total)")"
  add SeriesUsedPercent "$(printf '%s\n' "$metrics" | awk -v max="$MAX_SERIES_TOTAL" '$1 == "cortex_ingester_memory_series" {printf "%.1f", $2 * 100 / max}')"
  last=$(printf '%s\n' "$metrics" | awk '$1 == "cortex_compactor_last_successful_run_timestamp_seconds" {printf "%.0f", $2}')
  [ -n "$last" ] && [ "$last" -gt 0 ] && add CompactorHoursSinceSuccess "$(awk -v l="$last" -v n="$(date +%s)" 'BEGIN {printf "%.1f", (n - l) / 3600}')"
fi
aws cloudwatch put-metric-data --region "$REGION" --namespace PerfMimir --metric-data "[$data]" ||
  echo "mimir-watchdog: put-metric-data failed"
SCRIPT
chmod 0755 /usr/local/sbin/mimir-watchdog

for job in credentials:5min limits:5min tls:10min watchdog:1min; do
  name=$${job%%:*}; every=$${job##*:}
  cat > /etc/systemd/system/mimir-$name.service <<UNIT
[Unit]
Description=Mimir $name
[Service]
Type=oneshot
TimeoutStartSec=4min
ExecStart=/usr/local/sbin/mimir-$name
StandardOutput=append:/var/log/perf-mimir-ops.log
StandardError=inherit
UNIT
  cat > /etc/systemd/system/mimir-$name.timer <<UNIT
[Unit]
Description=Mimir $name every $every
[Timer]
OnBootSec=1min
OnUnitActiveSec=$every
AccuracySec=5s
[Install]
WantedBy=timers.target
UNIT
done

# --- CloudWatch agent: memory and disk metrics, Mimir, nginx and bootstrap logs ------------------------
# Metrics and logs only: a failure here mustn't leave the server half built.
if curl -fsSL "https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/$ARCH/latest/amazon-cloudwatch-agent.deb" -o /tmp/cwa.deb &&
  dpkg -i /tmp/cwa.deb; then CWA=1; else CWA=0; echo "server-init: CloudWatch agent install failed"; fi
rm -f /tmp/cwa.deb
mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<JSON
{
  "agent": { "metrics_collection_interval": 60 },
  "metrics": {
    "append_dimensions": { "InstanceId": "\$${aws:InstanceId}" },
    "aggregation_dimensions": [["InstanceId"], ["InstanceId", "path"]],
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/", "/data"], "drop_device": true }
    }
  },
  "logs": { "logs_collected": { "files": { "collect_list": [
    { "file_path": "/var/log/mimir/mimir.log", "log_group_name": "${log_group_mimir}", "log_stream_name": "{instance_id}/mimir",
      "filters": [{ "type": "exclude", "expression": "evaluation stats" }] },
    { "file_path": "/var/log/nginx/access.log", "log_group_name": "${log_group_nginx}", "log_stream_name": "{instance_id}/access" },
    { "file_path": "/var/log/nginx/error.log", "log_group_name": "${log_group_nginx}", "log_stream_name": "{instance_id}/error" },
    { "file_path": "/var/log/server-init.log", "log_group_name": "${log_group_system}", "log_stream_name": "{instance_id}/server-init" },
    { "file_path": "/var/log/perf-mimir-ops.log", "log_group_name": "${log_group_system}", "log_stream_name": "{instance_id}/ops" }
  ] } } }
}
JSON
[ "$CWA" = 1 ] && { /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json || echo "server-init: CloudWatch agent didn't start"; }

# --- Start ------------------------------------------------------------------------------------------
# Through systemd, so a timer firing meanwhile can't run the same script concurrently.
systemctl daemon-reload
systemctl start mimir-credentials.service mimir-limits.service || true
nginx -t
systemctl enable nginx
systemctl restart nginx
systemctl enable --now mimir.service
for name in credentials limits tls watchdog; do systemctl enable --now mimir-$name.timer; done
systemctl start mimir-tls.service || true
echo "server-init: done $(date -u +%FT%TZ)"
